# 개인 설정 파일. Git에 커밋하지 않는다. / Private configuration; never commit .env.
# python3 scripts/bootstrap.py --write-env 실행 시 토큰을 생성한다.
# The bootstrap command generates a token without overwriting an existing file.

# 필수·비밀값: MCP HTTP 접속 토큰. 최소 32자, 서버와 클라이언트에서 동일하게 사용.
# Required secret: MCP bearer token, at least 32 characters; use the same value on the client.
MCP_AUTH_TOKEN=

# 선택: 호스트의 MCP 포트. 기본 8080, 기본 Compose에서는 127.0.0.1에만 공개.
# Optional host port, default 8080; the base Compose binds to loopback only.
MCP_PORT=8080

# 모델 선택·고정 리비전·정밀도·배치·프롬프트는 models.toml에서 역할별로 설정한다.
# Choose per-role models, revisions, precision, batches and prompts in models.toml.
# 다른 파일 예: ./examples/inference/qwen3.toml, ./examples/inference/e5-bge.toml
# Other profiles: ./examples/inference/qwen3.toml, ./examples/inference/e5-bge.toml.
MODEL_CONFIG_PATH=./models.toml

# 소스·컬렉션·임베딩/리랭커 API 주소를 담은 설정 파일. 기존 파일을 덮어쓰지 않는다.
# Config for sources, collection and separate inference URLs; never overwrite existing settings.
RAG_CONFIG_PATH=./taco.toml

# 기본 모드는 한 프로세스에서 두 역할을 실행한다. 분리 구성은 docs/models.md 참고.
# The base stack serves both roles in one process; see docs/models.md for split processes.
INFERENCE_ROLE=all

# 호스트 GPU 번호. 기본 모드에서는 두 모델이 이 GPU를 공유한다.
# Host GPU ID; the combined process shares this GPU between both models.
EMBEDDING_GPU_ID=0

# compose.inference-split.yaml에서만 사용. 같은 GPU라면 두 프로세스의 VRAM을 합산한다.
# Used only by compose.inference-split.yaml; sum both processes' VRAM when sharing a GPU.
RERANKER_GPU_ID=0

# 선택·비밀값: 비공개/승인형 Hugging Face 모델 다운로드 토큰. 모델 라이선스는 별도 확인.
# Optional secret for private/gated Hugging Face downloads; review model licenses separately.
HF_TOKEN=

# 선택·비밀값: 별도 임베딩/리랭커 API의 토큰. taco.toml의 *_token_env로 이름을 연결한다.
# Optional secrets for separate inference APIs; reference their names with *_token_env in taco.toml.
# 기본 내부 GPU API에는 설정하지 않는다. MCP 토큰과도 별개다.
# Leave unset for the internal GPU APIs; these are separate from the MCP token.
EMBEDDING_API_TOKEN=
RERANKER_API_TOKEN=

# 아래 생성 모델 설정은 선택 사항. 검색 MCP만 사용한다면 비워 둔다.
# Generation is optional. Leave these empty when only using retrieval MCP tools.

# 비밀값: 자체 호스팅 OpenAI 호환 생성 서버의 API 토큰. MCP 토큰과 별개.
# Secret for the self-hosted OpenAI-compatible generator; separate from the MCP token.
GENERATOR_TOKEN=

# 자체 생성 서버를 띄울 때만 필요: 고정 vLLM CUDA 이미지·모델·리비전.
# Required only by compose.generator.yaml: pinned CUDA image, model and revision.
# 모델별 파서는 docs/models.md와 해당 런타임 문서를 확인한다.
# Check docs/models.md and the serving runtime's model-specific tool parser documentation.
GENERATOR_IMAGE=
GENERATOR_MODEL=
GENERATOR_REVISION=

# agent 모드의 도구 파서. 도구 없는 서버는 비워 두고 클라이언트도 rag 모드를 선택한다.
# Tool parser for agent mode; leave empty for text-only servers and select rag on the client.
GENERATOR_TOOL_CALL_PARSER=

# 선택: 모델과 vLLM 버전에 맞는 thinking 파서. 일반 생성 모델은 비워 둔다.
# Optional reasoning parser for the chosen model/runtime; leave empty for ordinary models.
GENERATOR_REASONING_PARSER=

# 선택: 생성 서버 GPU 번호·메모리 비율·문맥 길이. VRAM 공유 여부를 먼저 확인.
# Optional generator GPU ID, memory fraction and context length. Check VRAM before sharing a GPU.
GENERATOR_GPU_ID=1
GENERATOR_MEMORY_FRACTION=0.7
GENERATOR_CONTEXT=8192

# 선택: 동시 처리 수와 eager 실행. 비우면 동시 처리 수는 vLLM 기본값을 사용한다.
# Optional concurrency and eager execution; an empty sequence count keeps the vLLM default.
# eager 실행은 CUDA graph/compile 사용을 줄이며 속도·메모리 사용이 달라질 수 있다.
# Eager execution reduces graph/compile use and can change speed and memory requirements.
GENERATOR_MAX_SEQUENCES=
GENERATOR_EAGER=false

# 선택·비밀값: Anthropic API 모드의 키. Claude CLI 구독/OAuth 인증과 호환되지 않음.
# Optional secret for Anthropic API mode; not interchangeable with Claude CLI subscription/OAuth.
ANTHROPIC_API_KEY=

# 선택·비밀값: REST 예제 커넥터용 토큰. 해당 커넥터를 켰을 때만 필요.
# Optional secret for the example REST connector; required only when that source is enabled.
SUPPORT_API_TOKEN=
